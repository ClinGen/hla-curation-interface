# Copy this file to .env and fill in the values. Keep the keys in sync with .env;
# `just env-check` reports any differences.

# Clerk authentication keys, from the Clerk dashboard.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Django settings: config.settings.dev on your machine, config.settings.prod on a server.
DJANGO_SETTINGS_MODULE=
ENV=
SECRET_KEY=

# NCBI API key, which raises the PubMed rate limit. Optional.
PUBMED_API_KEY=

# Set to 1 to run tests that call external services.
RUN_CONTRACT_TESTS=

# Sentry error monitoring.
SENTRY_DSN=
SENTRY_ENV=

# Server-only keys. Leave them empty on your machine. See How to Configure Backup
# Credentials and How to Configure Email in docs/how-to.md.
ALERT_EMAILS=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
DBBACKUP_BUCKET_NAME=
DEFAULT_FROM_EMAIL=
EMAIL_HOST_PASSWORD=
EMAIL_HOST_USER=
SUBDOMAIN=
